.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Build/tooling logs. NOTE: this project *analyses* Proxifier logs, whose
# real-world extension is `.txt`, so committed fixtures are unaffected by
# these patterns. Do not "fix" that by whitelisting `*.log` here — see the
# capture rules below for why real logs must stay out of the repo.
*.log
logs

# Generated IPC types (regenerated on build)
packages/ipc-schema/dist

# Tauri updater signing keys — PRIVATE KEY MUST NEVER BE COMMITTED.
# Public key (.pub) is safe to share but we keep the whole dir excluded so
# there's zero risk of accidentally publishing the private one; the public
# key is already embedded in src-tauri/tauri.conf.json.
.tauri-keys/

# ---------------------------------------------------------------------------
# REAL CAPTURES — never commit.
#
# A real Proxifier log records every hostname and IP the machine contacted and
# its internal network layout; a real `.ppx` carries the master-password hash
# and the operator's actual proxy addresses. Neither can be un-published once
# pushed.
#
# Test input is synthetic and lives in `testdata/`, generated by
# `tools/gen-sample-log.py`. A `.ppx` or a Proxifier log anywhere else is
# somebody's real configuration.
# ---------------------------------------------------------------------------
*.ppx
!crates/ppx-core/tests/fixtures/*.ppx
Log.txt*
examples/


# TypeScript incremental build cache
*.tsbuildinfo
